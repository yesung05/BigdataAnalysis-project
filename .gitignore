# ---- 데이터 (대용량, git 추적 제외) ----
data/
!data/.gitkeep
# 가공 산출물은 재생성 가능하므로 제외
outputs/
!outputs/.gitkeep

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# ---- 가상환경 ----
.venv/
venv/
env/

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 비밀키 / 환경변수 ----
.env
*.key
secrets.toml
.streamlit/secrets.toml

# ---- 캐시 파일 (parquet 변환 결과) ----
*.parquet
*.feather
